APP_NAME=AMPUH
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Isi dengan URL publik saat hosting (mis. https://ampuh.example.com). Dipakai untuk callback pembayaran.
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local: sqlite (buat file database/database.sqlite). Production: mysql / pgsql.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=ampuh
# DB_USERNAME=ampuh
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Payment: Midtrans (https://dashboard.sandbox.midtrans.com) ---
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_IS_SANITIZED=true
MIDTRANS_IS_3DS=true

# --- Payment: CoinPayments (crypto) ---
COINPAYMENTS_API_URL=
COINPAYMENTS_CLIENT_ID=
COINPAYMENTS_CLIENT_SECRET=
COINPAYMENTS_IPN_SECRET=

# --- Payment: DOKU (legacy, opsional) ---
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_PRIVATE_KEY=
DOKU_PUBLIC_KEY=
DOKU_IS_PRODUCTION=false
DOKU_ISSUER=MARKETPLACE_UMKM
DOKU_PARTNER_SERVICE_ID=

# --- Blockchain: Base (lihat blockchain/README.md) ---
# Lokal: jalankan blockchain/start-local.sh lalu blockchain/deploy-local.sh, salin BASE_* yang dicetak.
# Checkout tetap berjalan walau BASE_ENABLED=false; pesanan hanya tidak dicatat on-chain.
BASE_ENABLED=false
BASE_NETWORK_NAME="Base Sepolia (local fork)"
BASE_RPC_URL=http://127.0.0.1:8545
BASE_CHAIN_ID=84532
BASE_REGISTRY_ADDRESS=
BASE_RECORDER_PRIVATE_KEY=
BASE_EXPLORER_URL=

# --- OTP SMS seller ---
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
SMS_SENDER_ID=
