# Staging (https://staging.ampuh.finance). Copy to the server as
# domains/ampuh.finance/public_html/staging/web_umkm/.env and fill the <...> values.
# Never reuse production's database, APP_KEY, Midtrans production keys or Base recorder key.
APP_NAME="AMPUH Staging"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging.ampuh.finance
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file

# Open the site once with https://staging.ampuh.finance/?access=<key>. Generate with: openssl rand -hex 24
STAGING_ACCESS_KEY=<random key>

BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Its own MySQL database, created in hPanel (Databases -> Management).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=<u595677082_staging>
DB_USERNAME=<u595677082_staging>
DB_PASSWORD=<password>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=ampuh_staging

# log: no email leaves staging. Seller OTP codes are then shown on the reset page.
# For real inboxes use a sandbox SMTP such as Mailtrap instead.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="staging@ampuh.finance"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Midtrans sandbox (https://dashboard.sandbox.midtrans.com). Staging forces sandbox mode in code.
# Notification URL in the sandbox dashboard: https://staging.ampuh.finance/api/midtrans/callback
MIDTRANS_SERVER_KEY=<SB-Mid-server-...>
MIDTRANS_CLIENT_KEY=<SB-Mid-client-...>
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_IS_SANITIZED=true
MIDTRANS_IS_3DS=true

# CoinPayments: leave empty, or use a test account paying in LTCT only.
COINPAYMENTS_API_URL=
COINPAYMENTS_CLIENT_ID=
COINPAYMENTS_CLIENT_SECRET=
COINPAYMENTS_IPN_SECRET=

DOKU_IS_PRODUCTION=false

# Base Sepolia (testnet) with a registry and recorder wallet used only by staging.
# Staging refuses to anchor on Base mainnet (chain 8453) even if configured.
BASE_ENABLED=true
BASE_NETWORK_NAME="Base Sepolia"
BASE_RPC_URL=https://sepolia.base.org
BASE_CHAIN_ID=84532
BASE_REGISTRY_ADDRESS=<0x... staging OrderRegistry>
BASE_RECORDER_PRIVATE_KEY=<0x... staging-only recorder key>
BASE_EXPLORER_URL=https://sepolia.basescan.org

# The MPC signer cannot run on shared hosting.
MPC_WALLET_ENABLED=false
